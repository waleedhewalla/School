{
    // Run Nbras in the browser with GitHub Codespaces — nothing to install.
    // On GitHub: Code → Codespaces → Create codespace on this branch.
    "name": "Nbras",
    "image": "mcr.microsoft.com/devcontainers/php:8.3",
    "features": {
        "ghcr.io/devcontainers/features/node:1": { "version": "22" }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "postAttachCommand": "php artisan serve --host=0.0.0.0 --port=8000",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": { "label": "Nbras", "onAutoForward": "openBrowser" }
    }
}
