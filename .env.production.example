# Production settings. Copy to .env.production and fill in; never commit it.
APP_NAME=Madrasa
APP_ENV=production
APP_DEBUG=false
# docker compose -f compose.production.yml run --rm app php artisan key:generate --show
APP_KEY=
APP_URL=https://school.example.sa
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
# "*" when a load balancer / TLS proxy sits in front of the app
TRUSTED_PROXIES=*

DB_DATABASE=madrasa
DB_USERNAME=madrasa
DB_PASSWORD=
DB_PORT=5432

SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SANCTUM_EXPIRATION=43200

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.sa
MAIL_FROM_NAME=Madrasa

# SMS: unifonic or taqnyat (log only writes to the log)
SMS_DRIVER=unifonic
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
TAQNYAT_TOKEN=
TAQNYAT_SENDER=

# WhatsApp Business (Meta Cloud API): meta or log
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ATTENDANCE_TEMPLATE=attendance_alert
WHATSAPP_ADMISSION_TEMPLATE=admission_update

# Report-card PDFs: "gotenberg" with `--profile pdf`, or "none" (browser print only)
PDF_DRIVER=none

BACKUP_KEEP_DAYS=14
RUN_MIGRATIONS=true
